<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_clock"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/time_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:shadowColor="#80000000"
            android:shadowRadius="6"
            android:textColor="@color/white"
            android:textSize="54sp" />

        <TextClock
            android:id="@+id/sec_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:format12Hour=":ss"
            android:format24Hour=":ss"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:textColor="@color/red"
            android:textSize="54sp" />
    </LinearLayout>

    <TextClock
        android:id="@+id/date_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:format12Hour="EEEE, MMM d"
        android:format24Hour="EEEE, MMM d"
        android:includeFontPadding="false"
        android:textColor="@color/date_gray"
        android:textSize="18sp" />
</LinearLayout>
